# ─────────────────────────────────────────────────────────────────
# ChainTickets — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Blockchain Network ──────────────────────────────────────────
# Your wallet's private key for deploying contracts.
# Use a DEDICATED DEPLOYER WALLET — never your main wallet.
# Format: 0x followed by 64 hex characters.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Sepolia testnet RPC URL (from Alchemy, Infura, or QuickNode)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Frontend (Vite) ─────────────────────────────────────────────
# Deployed contract address (set after running deploy script)
# This can also be read from the auto-generated EventTicketing.json
VITE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Chain ID: 31337 for local Hardhat, 11155111 for Sepolia
VITE_CHAIN_ID=31337

# Comma-separated supported chain IDs
VITE_SUPPORTED_CHAIN_IDS=31337,11155111

# ── Optional: Backend API (if applicable) ───────────────────────
# VITE_API_URL=https://your-backend.onrender.com

# ── Gas Reporting (optional) ────────────────────────────────────
REPORT_GAS=false
